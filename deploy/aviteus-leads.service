[Unit]
Description=Aviteus Healthcare website lead handler
After=network-online.target

[Service]
User=aviteus
Group=aviteus
EnvironmentFile=/etc/aviteus/lead-handler.env
WorkingDirectory=/opt/aviteus
ExecStart=/usr/bin/python3 /opt/aviteus/server/lead_handler.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aviteus
PrivateTmp=true

[Install]
WantedBy=multi-user.target
