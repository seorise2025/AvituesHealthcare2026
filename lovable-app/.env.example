# Where the forms send. Set ONE of these.
#
# Option A: Lovable Cloud / Supabase. Lovable fills these two in when you
# enable Cloud. The forms then call the "submit-lead" edge function.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Option B: the Python lead handler in ../server on your own server.
# Must be same-origin or allow CORS. Example: https://aviteushealthcare.co.uk/api/enquiry
VITE_LEAD_ENDPOINT=
