# Aviteus Healthcare - nginx server block (static site)
#
# THE LIVE BUG TODAY: nginx serves /about-us.html but returns 404 for /about-us.
# The nav links to /about-us, so every menu click is a dead end.
# Hot-fix for the CURRENT site (before the rebuild goes live), add this one line
# inside the existing location / block:
#
#     try_files $uri $uri.html $uri/ =404;
#
# Then reload:  sudo nginx -t && sudo systemctl reload nginx

server {
    listen 443 ssl http2;
    server_name aviteushealthcare.co.uk;
    root /var/www/aviteus/site;
    index index.html;

    # Clean URLs with trailing slash: /hire-staff/ -> /hire-staff/index.html
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    # --- 301 redirects from the old site ---
    location = /about-us       { return 301 /about-us/; }
    location = /about-us.html  { return 301 /about-us/; }
    location = /contact-us     { return 301 /contact-us/; }
    location = /contact-us.html { return 301 /contact-us/; }
    location = /candidates     { return 301 /candidates/; }
    location = /candidates.html { return 301 /candidates/; }
    location = /clients        { return 301 /hire-staff/; }
    location = /clients.html   { return 301 /hire-staff/; }
    location = /services       { return 301 /hire-staff/; }
    location = /services.html  { return 301 /hire-staff/; }
    location = /privacy-policy { return 301 /privacy-policy/; }
    location = /privacy-policy.html { return 301 /privacy-policy/; }
    location = /index.html     { return 301 /; }

    # Keep the PDF paths exactly as they are. They are indexed in Google.
    location /files/ { try_files $uri =404; }

    error_page 404 /404.html;

    # Cache static assets
    location /assets/ { expires 30d; add_header Cache-Control "public"; }

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
}

# Force one host: www and http go to https://aviteushealthcare.co.uk
server {
    listen 80;
    listen 443 ssl http2;
    server_name www.aviteushealthcare.co.uk;
    return 301 https://aviteushealthcare.co.uk$request_uri;
}
server {
    listen 80;
    server_name aviteushealthcare.co.uk;
    return 301 https://aviteushealthcare.co.uk$request_uri;
}
