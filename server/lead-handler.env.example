# Copy to /etc/aviteus/lead-handler.env on the server, chmod 600, owner root.
# Never commit the real file. Every value below is an example.

# Where leads are stored (outside the web root)
LEAD_DB_PATH=/var/lib/aviteus/leads.db
LEAD_RETENTION_DAYS=90            # must match the privacy notice

# Who receives each form (comma-separated)
LEAD_TO_EMPLOYER=bookings@example.co.uk
LEAD_TO_CANDIDATE=recruitment@example.co.uk
LEAD_TO_GENERAL=info@example.co.uk

# Outgoing email (use a transactional email service or Microsoft 365 / Google Workspace SMTP)
MAIL_FROM=no-reply@aviteushealthcare.co.uk
MAIL_FROM_NAME=Aviteus Healthcare
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SEND_CONFIRMATION=true

# CRM (optional). Receives JSON: ref, lead_type, created_at, fields, source
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Abuse protection
ALLOWED_ORIGINS=https://aviteushealthcare.co.uk
RATE_LIMIT=5
RATE_WINDOW_SECONDS=900
MIN_FILL_SECONDS=3
TURNSTILE_SECRET=                 # optional Cloudflare Turnstile secret

PUBLIC_PHONE=020 3488 8172
SITE_URL=https://aviteushealthcare.co.uk
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8081
TRUST_PROXY=true
